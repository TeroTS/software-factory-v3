title: "Per-Job lifecycle — current happy path\nFailure/timeout limits: docs/operations.md" {
  shape: text
}
flow: {
  shape: sequence_diagram
  submitter: "Operator / Dispatcher"
  workflow: "Step Functions Standard"
  aws: "AWS Lambda MicroVMs"
  server: "Lifecycle server :8080"
  worker: "Worker + fresh Codex stages"
  github: "Authorized GitHub repository"
  queue: "Job queue"

  submitter -> workflow: "Starts direct [Job] or queued {jobs: [Job], queue}"
  workflow -> aws: "RunMicrovm: pinned version; execution-name client token; 30-min lifespan"
  aws -> workflow: "Returns VM ID and endpoint"
  aws -> server: "Restores snapshot; POST /aws/lambda-microvms/runtime/v1/run"
  server -> worker: "Starts one asynchronous worker with validated Job"
  server -> aws: "200 startup acknowledgement"
  workflow -> aws: "GetMicrovm: waits 5 seconds between startup checks"
  aws -> workflow: "RUNNING"
  workflow -> aws: "CreateMicrovmAuthToken once: port 8080, 30 minutes"
  aws -> workflow: "Returns opaque JWE"
  worker -> github: "Retrieves scoped token; clones pinned baseline; creates unique branch"
  worker -> worker: "Runs ./scripts/setup and baseline ./scripts/verify"
  worker -> worker: "Fresh implementation; independent verify; worker commits candidate"
  worker -> worker: "Fresh structured review; valid FAIL permits repair; at most 3 passes"
  workflow -> server: "GET /status via AWS ingress + JWE + port 8080"
  server -> workflow: "pending; workflow waits 10 seconds and reuses token"
  worker -> worker: "Final independent verify + unchanged reviewed-candidate check"
  worker -> github: "Fresh publication: push existing reviewed head; create matching OPEN PR"
  worker -> worker: "Independent identity/merge-eligibility gate"
  worker -> github: "Fresh exact-head merge request; no admin/auto/squash/rebase"
  github -> worker: "Matching MERGED PR + mergedAt + reviewed head"
  worker -> server: "Exits zero only after independent merged-PR confirmation"
  workflow -> server: "GET /status via AWS ingress with same JWE"
  server -> workflow: "ok"
  workflow -> aws: "TerminateMicrovm"
  aws -> server: "POST /aws/lambda-microvms/runtime/v1/terminate"
  server -> worker: "Stops process group and flushes available logs"
  server -> aws: "200 hook acknowledgement"
  workflow -> aws: "GetMicrovm: waits 5 seconds between termination checks"
  aws -> workflow: "TERMINATED"
  workflow -> queue: "Queued only: update same composite key to COMPLETED"
  workflow -> submitter: "Succeeds: VM ID, status ok, termination TERMINATED"
}
